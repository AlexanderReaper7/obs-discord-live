diff --git a/src/main/obsDiscordLive.ts b/src/main/obsDiscordLive.ts
new file mode 100644
index 0000000..ace53f9
--- /dev/null
+++ b/src/main/obsDiscordLive.ts
@@ -0,0 +1,159 @@
+/*
+ * Vesktop, a desktop app aiming to give you a snappier Discord Experience
+ * Copyright (c) 2026 Vendicated and Vencord contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Client for the obs-discord-live OBS plugin. The plugin encodes OBS's program
+// view and serves access units on a Unix socket, or on TCP when OBS runs in a
+// VM guest ($OBS_DISCORD_LIVE_ADDR=HOST:PORT); this side relays them to the
+// renderer, which puts them into the Go Live sender. Wire format: every message
+// is a u32 LE length of what follows, one type byte, then the payload; strings
+// are a u8 length and UTF-8. See proto/src/lib.rs in obs-discord-live.
+
+import { existsSync } from "fs";
+import { connect, NetConnectOpts, Socket } from "net";
+import { join } from "path";
+import { IpcEvents } from "shared/IpcEvents";
+
+import { mainWin } from "./mainWindow";
+import { handle } from "./utils/ipcWrappers";
+
+export const OBS_SOURCE_ID = "odl:obs";
+
+const C_START = 0x01;
+const C_KEYFRAME = 0x02;
+const C_BITRATE = 0x03;
+const C_STOP = 0x04;
+const S_CONFIG = 0x81;
+const S_FRAME = 0x82;
+const S_ERROR = 0x83;
+const MAX_MESSAGE = 16 << 20;
+
+export type OdlEvent =
+    | { type: "config"; codec: string; encoder: string; width: number; height: number; fpsNum: number; fpsDen: number }
+    | { type: "frame"; ptsUs: number; key: boolean; data: Uint8Array }
+    | { type: "error"; message: string }
+    | { type: "closed" };
+
+/** `$OBS_DISCORD_LIVE_ADDR`, HOST:PORT for TCP or a socket path, else the plugin's default socket. Matches `addr()` in proto/src/lib.rs. */
+export function address(): NetConnectOpts {
+    const v = process.env.OBS_DISCORD_LIVE_ADDR;
+    const tcp = v && !/[/\\]/.test(v) ? /^(.*):(\d+)$/.exec(v) : null;
+    if (tcp) return { host: tcp[1].replace(/^\[(.*)\]$/, "$1"), port: Number(tcp[2]), noDelay: true };
+    return { path: v || join(process.env.XDG_RUNTIME_DIR || "/tmp", "obs-discord-live.sock") };
+}
+
+/** The plugin listens only while OBS runs with it loaded. A TCP address is probed with a connect that the plugin sees as a client that left. */
+export function obsAvailable(): Promise<boolean> {
+    const a = address();
+    if ("path" in a) return Promise.resolve(process.platform === "linux" && existsSync(a.path));
+    return new Promise(resolve => {
+        const s = connect(a);
+        const done = (ok: boolean) => {
+            s.destroy();
+            resolve(ok);
+        };
+        s.setTimeout(500, () => done(false));
+        s.once("connect", () => done(true));
+        s.once("error", () => done(false));
+    });
+}
+
+let sock: Socket | null = null;
+
+function message(kind: number, payload: Buffer = Buffer.alloc(0)) {
+    const head = Buffer.alloc(5);
+    head.writeUInt32LE(payload.length + 1, 0);
+    head[4] = kind;
+    return Buffer.concat([head, payload]);
+}
+
+function u32(v: number) {
+    const b = Buffer.alloc(4);
+    b.writeUInt32LE(Math.max(0, Math.round(v)) >>> 0, 0);
+    return b;
+}
+
+function str(s: string) {
+    const b = Buffer.from(s, "utf8").subarray(0, 255);
+    return Buffer.concat([Buffer.from([b.length]), b]);
+}
+
+function emit(e: OdlEvent) {
+    if (!mainWin.isDestroyed()) mainWin.webContents.send(IpcEvents.ODL_EVENT, e);
+}
+
+function decode(kind: number, body: Buffer): OdlEvent | null {
+    let at = 0;
+    const s = () => {
+        const n = body[at];
+        const v = body.toString("utf8", at + 1, at + 1 + n);
+        at += 1 + n;
+        return v;
+    };
+    const n = () => {
+        const v = body.readUInt32LE(at);
+        at += 4;
+        return v;
+    };
+    switch (kind) {
+        case S_CONFIG:
+            return { type: "config", codec: s(), encoder: s(), width: n(), height: n(), fpsNum: n(), fpsDen: n() };
+        case S_FRAME:
+            return {
+                type: "frame",
+                ptsUs: Number(body.readBigUInt64LE(0)),
+                key: body[8] !== 0,
+                // A copy, so IPC does not serialize the whole socket buffer behind the view.
+                data: new Uint8Array(body.subarray(9))
+            };
+        case S_ERROR:
+            return { type: "error", message: s() };
+        default:
+            return null;
+    }
+}
+
+function start(codec: string, kbps: number) {
+    stop();
+    const s = connect(address());
+    sock = s;
+    let buf: Buffer = Buffer.alloc(0);
+    s.on("data", (chunk: Buffer) => {
+        buf = buf.length ? Buffer.concat([buf, chunk]) : chunk;
+        while (buf.length >= 4) {
+            const len = buf.readUInt32LE(0);
+            if (len === 0 || len > MAX_MESSAGE) {
+                emit({ type: "error", message: `message length ${len} out of range` });
+                s.destroy();
+                return;
+            }
+            if (buf.length < 4 + len) break;
+            const e = decode(buf[4], buf.subarray(5, 4 + len));
+            buf = buf.subarray(4 + len);
+            if (e) emit(e);
+        }
+    });
+    s.on("error", err => {
+        if (sock === s) emit({ type: "error", message: err.message });
+    });
+    s.on("close", () => {
+        if (sock !== s) return;
+        sock = null;
+        emit({ type: "closed" });
+    });
+    s.write(message(C_START, Buffer.concat([str(codec), u32(kbps)])));
+}
+
+function stop() {
+    const s = sock;
+    if (!s) return;
+    sock = null;
+    s.end(message(C_STOP));
+}
+
+handle(IpcEvents.ODL_START, (_, codec: string, kbps: number) => start(codec, kbps));
+handle(IpcEvents.ODL_KEYFRAME, () => sock?.write(message(C_KEYFRAME)));
+handle(IpcEvents.ODL_SET_BITRATE, (_, kbps: number) => sock?.write(message(C_BITRATE, u32(kbps))));
+handle(IpcEvents.ODL_STOP, () => stop());
