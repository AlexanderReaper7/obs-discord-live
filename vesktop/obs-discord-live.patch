diff --git a/src/renderer/obsDiscordLive.ts b/src/renderer/obsDiscordLive.ts
new file mode 100644
index 0000000..c4dcf80
--- /dev/null
+++ b/src/renderer/obsDiscordLive.ts
@@ -0,0 +1,397 @@
+/*
+ * Vesktop, a desktop app aiming to give you a snappier Discord Experience
+ * Copyright (c) 2026 Vendicated and Vencord contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Puts the frames that the obs-discord-live OBS plugin encodes into the Go Live
+// sender, so Discord sends OBS's encode instead of encoding a capture itself.
+//
+// Discord gives every sender an RTCRtpScriptTransform into its encryption
+// worker. For a video sender while an OBS session runs, the patch takes the
+// sender's encoded frames with createEncodedStreams() instead, swaps each
+// frame's payload for the plugin's next access unit, and posts the streams to
+// the same worker in the message Discord's worker already accepts for a
+// transform. Encryption, packetization and congestion control stay Discord's.
+//
+// The Go Live track is a MediaStreamTrackGenerator that gets one black frame per
+// plugin frame, so Chromium encodes one frame for each access unit. The swap
+// pairs them in order: an encoded frame's RTP timestamp follows the wall clock
+// of the write, not the VideoFrame timestamp, so order is the only reliable key.
+//
+// Discord's own preview plays the sender's track, which is black. The patch
+// decodes the plugin's frames into a second track and gives that to any video
+// element that is handed the Go Live track.
+
+import { Logger } from "@vencord/types/utils";
+
+import type { OdlEvent } from "../main/obsDiscordLive";
+
+const logger = new Logger("ObsDiscordLive");
+
+/** The ENCRYPT operation and RTC_TRANSFORM message type of Discord's encryption worker. */
+const ENCRYPT = 0;
+const RTC_TRANSFORM = 1;
+
+const START_KBPS = 1000;
+/** A queue longer than this means Chromium dropped frames; a keyframe resyncs. */
+const MAX_BACKLOG = 2;
+/** Frames queued before any sender takes them are dropped beyond this. */
+const MAX_QUEUE = 30;
+const KEYFRAME_INTERVAL_MS = 300;
+/**
+ * The encoding's frame rate cap. At Discord's 30, Chromium dropped about one
+ * generated frame a minute that arrived early at a 30 fps plugin; at 60 it
+ * dropped none in a minute (2026-10-24). Each drop costs a keyframe.
+ */
+const MAX_FRAMERATE = 60;
+
+/** WebCodecs names for what the plugin's encoders produce. */
+const DECODER_CODECS: Record<string, string> = {
+    H264: "avc1.42e01f",
+    AV1: "av01.0.08M.08",
+    VP8: "vp8",
+    VP9: "vp09.00.10.08"
+};
+
+/** Decodes the plugin's frames into a track for the local preview. */
+class Preview {
+    readonly track: MediaStreamTrack;
+    readonly stream: MediaStream;
+    private writer: WritableStreamDefaultWriter<VideoFrame>;
+    private decoder: VideoDecoder | null = null;
+    private codec = "";
+    private needKey = true;
+
+    constructor() {
+        this.track = new (window as any).MediaStreamTrackGenerator({ kind: "video" });
+        this.writer = (this.track as any).writable.getWriter();
+        this.stream = new MediaStream([this.track]);
+    }
+
+    configure(codec: string) {
+        this.close();
+        this.codec = codec;
+        const name = DECODER_CODECS[codec];
+        if (!name) return;
+        const decoder = new VideoDecoder({
+            output: f => {
+                // A preview that falls behind skips frames rather than lagging.
+                if ((this.writer.desiredSize ?? 1) <= 0) return f.close();
+                this.writer.write(f).catch(() => f.close());
+            },
+            error: e => {
+                logger.warn("preview decoder:", e);
+                if (this.decoder === decoder) this.decoder = null;
+            }
+        });
+        decoder.configure({ codec: name, optimizeForLatency: true });
+        this.decoder = decoder;
+        this.needKey = true;
+    }
+
+    decode(key: boolean, data: ArrayBuffer, ptsUs: number) {
+        if (!this.decoder && key && this.codec) this.configure(this.codec);
+        const d = this.decoder;
+        if (!d || d.state !== "configured" || (this.needKey && !key)) return;
+        if (d.decodeQueueSize > 5) {
+            this.needKey = true;
+            return;
+        }
+        this.needKey = false;
+        d.decode(new EncodedVideoChunk({ type: key ? "key" : "delta", timestamp: ptsUs, data }));
+    }
+
+    close() {
+        if (this.decoder?.state !== "closed") this.decoder?.close();
+        this.decoder = null;
+    }
+
+    end() {
+        this.close();
+        this.writer.close().catch(() => {});
+    }
+}
+
+interface Unit {
+    key: boolean;
+    data: ArrayBuffer;
+}
+
+interface Session {
+    track: MediaStreamTrack;
+    writer: WritableStreamDefaultWriter<VideoFrame>;
+    preview: Preview;
+    codec: string;
+    kbps: number;
+    width: number;
+    height: number;
+    black: Uint8Array | null;
+    queue: Unit[];
+    sender: RTCRtpSender | null;
+    sawKey: boolean;
+    lastKeyRequest: number;
+    plis: number;
+    poll: ReturnType<typeof setInterval>;
+    swapped: number;
+    dropped: number;
+}
+
+let session: Session | null = null;
+
+function requestKeyframe(s: Session, why: string) {
+    const now = performance.now();
+    if (now - s.lastKeyRequest < KEYFRAME_INTERVAL_MS) return;
+    s.lastKeyRequest = now;
+    logger.info("keyframe request:", why);
+    VesktopNative.obsLive.keyframe();
+}
+
+function blackI420(w: number, h: number) {
+    const y = w * h;
+    const c = (w >> 1) * (h >> 1);
+    const b = new Uint8Array(y + 2 * c);
+    b.fill(16, 0, y);
+    b.fill(128, y);
+    return b;
+}
+
+function onEvent(e: OdlEvent) {
+    const s = session;
+    if (!s) return;
+    switch (e.type) {
+        case "config":
+            logger.info(`OBS encodes ${e.codec} with ${e.encoder}, ${e.width}x${e.height} at ${e.fpsNum}/${e.fpsDen}`);
+            s.width = e.width & ~1;
+            s.height = e.height & ~1;
+            s.black = blackI420(s.width, s.height);
+            s.queue = [];
+            s.preview.configure(e.codec);
+            break;
+        case "frame": {
+            if (!s.black) return;
+            const d = e.data;
+            const data =
+                d.byteOffset === 0 && d.byteLength === d.buffer.byteLength
+                    ? (d.buffer as ArrayBuffer)
+                    : (d.slice().buffer as ArrayBuffer);
+            if (e.key) s.queue = [];
+            else if (s.queue.length >= MAX_QUEUE) {
+                s.queue = [];
+                requestKeyframe(s, "queue overflow");
+            }
+            s.queue.push({ key: e.key, data });
+            s.preview.decode(e.key, data, e.ptsUs);
+            const frame = new VideoFrame(s.black, {
+                format: "I420",
+                codedWidth: s.width,
+                codedHeight: s.height,
+                timestamp: Math.round(performance.now() * 1000)
+            });
+            s.writer.write(frame).catch(err => {
+                logger.info("generator closed:", err);
+                stopSession();
+            });
+            break;
+        }
+        case "error":
+            logger.error("OBS plugin:", e.message);
+            break;
+        case "closed":
+            logger.warn("OBS plugin closed the connection");
+            break;
+    }
+}
+
+async function pollStats(s: Session) {
+    if (s.track.readyState === "ended") return stopSession();
+    if (!s.sender) return;
+    const stats = await s.sender.getStats();
+    stats.forEach((r: any) => {
+        if (r.type !== "outbound-rtp" || r.kind !== "video") return;
+        const plis = (r.pliCount ?? 0) + (r.firCount ?? 0);
+        if (plis > s.plis) requestKeyframe(s, `${plis - s.plis} PLI or FIR`);
+        s.plis = plis;
+        if (typeof r.targetBitrate !== "number" || r.targetBitrate <= 0) return;
+        const kbps = Math.round(r.targetBitrate / 1000);
+        if (Math.abs(kbps - s.kbps) > s.kbps * 0.05) {
+            s.kbps = kbps;
+            VesktopNative.obsLive.setBitrate(kbps);
+        }
+    });
+}
+
+/** Starts a session with the plugin and returns the track that carries it. */
+export function startObsTrack(): MediaStreamTrack {
+    stopSession();
+    const Generator = (window as any).MediaStreamTrackGenerator;
+    const track: MediaStreamTrack = new Generator({ kind: "video" });
+    // Chromium keeps the frame rate under load and gives up resolution instead,
+    // which costs nothing here: every frame it encodes is replaced.
+    track.contentHint = "motion";
+    const s: Session = {
+        track,
+        writer: (track as any).writable.getWriter(),
+        preview: new Preview(),
+        codec: "H264",
+        kbps: START_KBPS,
+        width: 0,
+        height: 0,
+        black: null,
+        queue: [],
+        sender: null,
+        sawKey: false,
+        lastKeyRequest: 0,
+        plis: 0,
+        poll: 0 as any,
+        swapped: 0,
+        dropped: 0
+    };
+    s.poll = setInterval(() => pollStats(s).catch(err => logger.error("stats:", err)), 1000);
+    session = s;
+    VesktopNative.obsLive.start(s.codec, s.kbps);
+    logger.info("session started");
+    return track;
+}
+
+function stopSession() {
+    const s = session;
+    if (!s) return;
+    session = null;
+    clearInterval(s.poll);
+    s.writer.close().catch(() => {});
+    s.preview.end();
+    VesktopNative.obsLive.stop();
+    logger.info(`session stopped: ${s.swapped} frames swapped, ${s.dropped} Chromium frames had no OBS frame`);
+}
+
+function raiseFramerate(sender: RTCRtpSender) {
+    const p = sender.getParameters();
+    const e = p.encodings?.[0];
+    if (!e || (e.maxFramerate ?? 0) >= MAX_FRAMERATE) return;
+    e.maxFramerate = MAX_FRAMERATE;
+    sender.setParameters(p).catch(err => logger.warn("could not raise maxFramerate:", err));
+}
+
+function swap(sender: RTCRtpSender, frame: RTCEncodedVideoFrame, ctl: TransformStreamDefaultController) {
+    const s = session;
+    if (!s || sender.track !== s.track) return ctl.enqueue(frame);
+    if (s.sender !== sender) {
+        s.sender = sender;
+        raiseFramerate(sender);
+    }
+
+    const codec = frame.getMetadata().mimeType?.split("/")[1]?.toUpperCase();
+    if (codec && codec !== s.codec) {
+        logger.info(`the sender negotiated ${codec}; restarting OBS's encoder`);
+        s.codec = codec;
+        s.queue = [];
+        s.black = null;
+        VesktopNative.obsLive.start(codec, s.kbps);
+        return;
+    }
+
+    // Chromium encodes a keyframe on a PLI; the plugin has to as well.
+    if (frame.type === "key") {
+        if (s.sawKey) requestKeyframe(s, "Chromium keyframe");
+        s.sawKey = true;
+    }
+
+    const k = s.queue.findLastIndex(u => u.key);
+    if (k > 0) s.queue.splice(0, k);
+    const unit = s.queue.shift();
+    if (!unit) {
+        s.dropped++;
+        return;
+    }
+    frame.data = unit.data;
+    ctl.enqueue(frame);
+    s.swapped++;
+    if (s.queue.length > MAX_BACKLOG) requestKeyframe(s, `${s.queue.length} frames behind`);
+}
+
+const transformInfo = new WeakMap<object, { worker: Worker; options: any }>();
+const senderKind = new WeakMap<RTCRtpSender, string>();
+const taken = new WeakSet<RTCRtpSender>();
+
+function install() {
+    const NativeTransform = window.RTCRtpScriptTransform;
+    const desc = Object.getOwnPropertyDescriptor(RTCRtpSender.prototype, "transform");
+    if (!NativeTransform || !desc?.set || !(window as any).MediaStreamTrackGenerator) {
+        logger.warn("this Chromium lacks a needed API; OBS streaming is off");
+        return;
+    }
+
+    window.RTCRtpScriptTransform = class extends NativeTransform {
+        constructor(worker: Worker, options?: any, transfer?: any[]) {
+            super(worker, options, transfer);
+            transformInfo.set(this, { worker, options });
+        }
+    } as typeof RTCRtpScriptTransform;
+
+    const { addTransceiver, addTrack } = RTCPeerConnection.prototype;
+    RTCPeerConnection.prototype.addTransceiver = function (this: RTCPeerConnection, trackOrKind: any, init?: any) {
+        const t = addTransceiver.call(this, trackOrKind, init);
+        senderKind.set(t.sender, typeof trackOrKind === "string" ? trackOrKind : trackOrKind.kind);
+        return t;
+    } as typeof addTransceiver;
+    RTCPeerConnection.prototype.addTrack = function (this: RTCPeerConnection, track: MediaStreamTrack, ...streams) {
+        const sender = addTrack.call(this, track, ...streams);
+        senderKind.set(sender, track.kind);
+        return sender;
+    };
+
+    Object.defineProperty(RTCRtpSender.prototype, "transform", {
+        ...desc,
+        set(this: RTCRtpSender, t: any) {
+            if (taken.has(this)) return;
+            const info = t && transformInfo.get(t);
+            const kind = senderKind.get(this) ?? this.track?.kind;
+            if (!session || !info || info.options?.operation !== ENCRYPT || kind !== "video") {
+                return desc.set!.call(this, t);
+            }
+            try {
+                const { readable, writable } = (this as any).createEncodedStreams();
+                const sender = this;
+                const swapped = readable.pipeThrough(
+                    new TransformStream({ transform: (f, ctl) => swap(sender, f, ctl) })
+                );
+                info.worker.postMessage(
+                    { type: RTC_TRANSFORM, operation: info.options.operation, readable: swapped, writable },
+                    [swapped, writable]
+                );
+                taken.add(this);
+                logger.info("took a video sender's encoded frames");
+            } catch (err) {
+                logger.error("could not take the sender's frames; Discord encodes this one", err);
+                desc.set!.call(this, t);
+            }
+        }
+    });
+
+    // A video element handed the Go Live track plays the decoded preview
+    // instead. The getter returns what Discord set, so its own comparisons hold.
+    const srcObject = Object.getOwnPropertyDescriptor(HTMLMediaElement.prototype, "srcObject")!;
+    const assigned = new WeakMap<HTMLMediaElement, { original: MediaStream; shown: MediaStream }>();
+    Object.defineProperty(HTMLMediaElement.prototype, "srcObject", {
+        ...srcObject,
+        get(this: HTMLMediaElement) {
+            const real = srcObject.get!.call(this);
+            const a = assigned.get(this);
+            return a && real === a.shown ? a.original : real;
+        },
+        set(this: HTMLMediaElement, v: MediaProvider | null) {
+            const s = session;
+            if (s && v instanceof MediaStream && v.getVideoTracks().includes(s.track)) {
+                assigned.set(this, { original: v, shown: s.preview.stream });
+                return srcObject.set!.call(this, s.preview.stream);
+            }
+            assigned.delete(this);
+            srcObject.set!.call(this, v);
+        }
+    });
+
+    VesktopNative.obsLive.onEvent(onEvent);
+}
+
+if (navigator.userAgent.includes("Linux")) install();
